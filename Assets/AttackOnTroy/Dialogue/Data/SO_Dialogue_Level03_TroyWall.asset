%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 45351e6359684edba03efc507976cc0a, type: 3}
  m_Name: SO_Dialogue_Level03_TroyWall
  m_EditorClassIdentifier: Assembly-CSharp::LevelDialogueData
  achillesOpeningLines:
  - speakerName: Achilles
    text: The great walls of Troy stand before us! Two monstrous sentinels guard the gate!
    speakerColor: {r: 1, g: 0.85, b: 0.2, a: 1}
  - speakerName: Cyclops Normal
    text: You shall not pass, Achilles! Our wall is unbreakable stone!
    speakerColor: {r: 0.95, g: 0.35, b: 0.25, a: 1}
  - speakerName: Cyclops Heavy
    text: AND I AM THE HAMMER BEHIND THE GATE! We will crush you together!
    speakerColor: {r: 0.95, g: 0.45, b: 0.15, a: 1}
  - speakerName: Achilles
    text: Neither stone walls nor twin titans can stay my wrath! Fall before me!
    speakerColor: {r: 1, g: 0.85, b: 0.2, a: 1}
  odysseusOpeningLines:
  - speakerName: Odysseus
    text: The high ramparts of Troy... defended by both a vanguard and a heavy titan inside.
    speakerColor: {r: 0.4, g: 0.85, b: 0.95, a: 1}
  - speakerName: Cyclops Normal
    text: Turn back, mortal! No arrow can breach these sacred battlements!
    speakerColor: {r: 0.95, g: 0.35, b: 0.25, a: 1}
  - speakerName: Cyclops Heavy
    text: I guard the inner fortress! You will burn before you touch this gate!
    speakerColor: {r: 0.95, g: 0.45, b: 0.15, a: 1}
  - speakerName: Odysseus
    text: Every wall has a weakness. Cunning and fire shall breach Troy this day!
    speakerColor: {r: 0.4, g: 0.85, b: 0.95, a: 1}
  enemyEntries:
  - enemyId: CyclopsNormal
    preFirstAttackLines:
    - speakerName: Cyclops Normal
      text: Defend the outer gate! Taste my axe, invader!
      speakerColor: {r: 0.95, g: 0.35, b: 0.25, a: 1}
    tauntLines:
    - speakerName: Cyclops Normal
      text: You cannot crack our stone defenses!
      speakerColor: {r: 0.95, g: 0.35, b: 0.25, a: 1}
    - speakerName: Cyclops Normal
      text: The wall stands strong and so do we!
      speakerColor: {r: 0.95, g: 0.35, b: 0.25, a: 1}
    - speakerName: Cyclops Normal
      text: Fall back to the sea, Greek dogs!
      speakerColor: {r: 0.95, g: 0.35, b: 0.25, a: 1}
  - enemyId: CyclopsHeavy
    preFirstAttackLines:
    - speakerName: Cyclops Heavy
      text: FROM BEHIND THE WALL, TITAN MIGHT SMASHES ALL!
      speakerColor: {r: 0.95, g: 0.45, b: 0.15, a: 1}
    tauntLines:
    - speakerName: Cyclops Heavy
      text: Even if you breach the wall, you cannot breach ME!
      speakerColor: {r: 0.95, g: 0.45, b: 0.15, a: 1}
    - speakerName: Cyclops Heavy
      text: I will bury your remains beneath Troy's fallen stones!
      speakerColor: {r: 0.95, g: 0.45, b: 0.15, a: 1}
    - speakerName: Cyclops Heavy
      text: Witness true behemoth strength!
      speakerColor: {r: 0.95, g: 0.45, b: 0.15, a: 1}
  achillesVictoryLines:
  - speakerName: Achilles
    text: The guardians are broken! The great wall of Troy lies open before Greece!
    speakerColor: {r: 1, g: 0.85, b: 0.2, a: 1}
  odysseusVictoryLines:
  - speakerName: Odysseus
    text: The twin titans have fallen and the wall is breached. Troy's fate is sealed!
    speakerColor: {r: 0.4, g: 0.85, b: 0.95, a: 1}
